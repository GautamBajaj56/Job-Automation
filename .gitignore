# ═══════════════════════════════════════════════════════════════════════
# Internship Acquisition System — .gitignore
# ═══════════════════════════════════════════════════════════════════════

# ── Secrets & Credentials ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# ── API Keys ───────────────────────────────────────────────────────────
*api_key*
*apikey*
*secret*
!*.example

# ── Node.js ────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ── IDE / Editor ───────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── OS ─────────────────────────────────────────────────────────────────
desktop.ini
ehthumbs.db

# ── Personal data (PII) ───────────────────────────────────────────────
*passport*
*diploma*
*resume-real*
*cv-real*

# ── career-ops subdirectory has its own .gitignore ─────────────────────
# We track career-ops as a cloned submodule/subdirectory; its own
# .gitignore handles its internal exclusions.
